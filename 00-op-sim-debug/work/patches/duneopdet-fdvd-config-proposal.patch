 dunefdvd_xarapuca_xe_xe10ppm_ext: @local::xarapuca_xe_xe10ppm_ext
 dunefdvd_xarapuca_xe_xe10ppm_ext.QuantumEfficiency: 0.027  # 3% X-ARAPUCA efficiency for Xe * 90% transmission through meshes in VD
 
+# Dark noise once per OpDet, on every OpDet (FD-VD runs four instances of SIPMOpSensorSim, one per photon product,
+# and each adds DarkNoiseRate on the OpDets it has photons for): all of it in the Xe instance, none in the others.
+# PROPOSAL, pending the rate convention (per OpDet or per readout channel) of the PDS experts.
+dunefdvd_xarapuca_xe_xe10ppm.DarkNoiseAllOpDets:     true
+dunefdvd_xarapuca_ar_xe10ppm.DarkNoiseRate:          0
+dunefdvd_xarapuca_ar_xe10ppm_ext.DarkNoiseRate:      0
+dunefdvd_xarapuca_xe_xe10ppm_ext.DarkNoiseRate:      0
+
 END_PROLOG
